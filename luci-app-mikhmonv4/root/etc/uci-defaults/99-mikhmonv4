#!/bin/sh

# Deteksi package manager
if command -v opkg >/dev/null 2>&1; then
    PKG="opkg"
elif command -v apk >/dev/null 2>&1; then
    PKG="apk"
else
    echo "❌ Package manager tidak didukung"
    exit 1
fi

# Cari versi PHP yang tersedia
for v in php8 php7 php; do
    if [ "$PKG" = "opkg" ]; then
        if opkg list-installed | grep -q "^${v}-cli "; then
            PHPVER="$v"
            break
        fi
    else
        if apk info -e "${v}" >/dev/null 2>&1; then
            PHPVER="$v"
            break
        fi
    fi
done

# Jika belum terinstall, cek repository
if [ -z "$PHPVER" ]; then
    for v in php8 php7 php; do
        if [ "$PKG" = "opkg" ]; then
            if opkg list | grep -q "^${v}-cli "; then
                PHPVER="$v"
                break
            fi
        else
            if apk search "${v}-cli" 2>/dev/null | grep -q "^${v}-cli-"; then
                PHPVER="$v"
                break
            fi
        fi
    done
fi

if [ -z "$PHPVER" ]; then
    echo "❌ Paket PHP tidak tersedia di repository."
    exit 1
fi

echo "✅ Menggunakan $PHPVER"

if [ "$PKG" = "opkg" ]; then
    opkg install \
        ${PHPVER}-cli \
        ${PHPVER}-mod-xml \
        ${PHPVER}-mod-filter \
        ${PHPVER}-mod-curl
else
    apk add \
        ${PHPVER} \
        ${PHPVER}-xml \
        ${PHPVER}-curl
fi

rm -rf /www/mikhmonv4
ln -sf /usr/share/mikhmonv4 /www/mikhmonv4

echo "✅ Mikhmon v4 siap diakses di Services → Mikhmon v4"
