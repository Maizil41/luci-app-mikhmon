#!/bin/sh

for v in php8 php7 php; do
    if opkg list-installed | grep -q "^${v}-cli "; then
        PHPVER="$v"
        break
    fi
done

if [ -z "$PHPVER" ]; then
    for v in php8 php7 php; do
        if opkg list | grep -q "^${v}-cli "; then
            PHPVER="$v"
            break
        fi
    done
fi

if [ -z "$PHPVER" ]; then
    echo "❌ Paket PHP tidak tersedia di repository."
    exit 1
fi

echo "✅ Menggunakan $PHPVER"

opkg install \
    ${PHPVER}-cli \
    ${PHPVER}-mod-xml \
    ${PHPVER}-mod-filter \
    ${PHPVER}-mod-curl

[ -L /www/mikhmonv3 ] || [ -e /www/mikhmonv3 ] && rm -rf /www/mikhmonv3
ln -sf /usr/share/mikhmonv3 /www/mikhmonv3

echo "✅ Mikhmon v3 siap diakses di Services → Mikhmon v3"
